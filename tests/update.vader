Before:
  " Build an offline fixture:
  "   bare/  - bare repo acting as the remote
  "   vim/   - fake vim config dir (parent git repo)
  "   vim/pack/plugins/start/myplugin  - the submodule clone
  "
  " Force the synchronous update path via g:plugin_manager_test_force_sync,
  " so tests are deterministic in headless mode (no event-loop dependency).

  let g:_pm_upd_saved = {
        \ 'vim_dir':     get(g:, 'plugin_manager_vim_dir', ''),
        \ 'cwd':         getcwd(),
        \ 'plugins_dir': get(g:, 'plugin_manager_plugins_dir', ''),
        \ 'vimrc':       get(g:, 'plugin_manager_vimrc_path', ''),
        \ 'logging':     get(g:, 'plugin_manager_enable_logging', 0),
        \ }

  let g:_pm_upd_root    = tempname()
  let g:_pm_upd_bare    = g:_pm_upd_root . '/bare'
  let g:_pm_upd_vim     = g:_pm_upd_root . '/vim'
  let g:_pm_upd_plug    = g:_pm_upd_vim  . '/pack/plugins/start/myplugin'
  let g:_pm_upd_tmp_src = g:_pm_upd_root . '/src'

  call mkdir(g:_pm_upd_root, 'p')

  " 1. Bare repo (upstream remote)
  call system('git init --bare ' . shellescape(g:_pm_upd_bare))
  call system('git -C ' . shellescape(g:_pm_upd_bare) . ' symbolic-ref HEAD refs/heads/main')

  " 2. Source working tree: initial commit + push to bare
  call mkdir(g:_pm_upd_tmp_src, 'p')
  call system('git init ' . shellescape(g:_pm_upd_tmp_src))
  call system('git -C ' . shellescape(g:_pm_upd_tmp_src) . ' config user.email "test@test.com"')
  call system('git -C ' . shellescape(g:_pm_upd_tmp_src) . ' config user.name "Test"')
  call system('git -C ' . shellescape(g:_pm_upd_tmp_src) . ' remote add origin ' . shellescape(g:_pm_upd_bare))
  call writefile(['v1'], g:_pm_upd_tmp_src . '/file.txt')
  call system('git -C ' . shellescape(g:_pm_upd_tmp_src) . ' add .')
  call system('git -C ' . shellescape(g:_pm_upd_tmp_src) . ' commit -m "initial"')
  call system('git -C ' . shellescape(g:_pm_upd_tmp_src) . ' push -u origin HEAD:main')
  call system('git -C ' . shellescape(g:_pm_upd_bare) . ' symbolic-ref HEAD refs/heads/main')

  " 3. Vim config dir as a git repo
  call mkdir(g:_pm_upd_vim, 'p')
  call system('git init ' . shellescape(g:_pm_upd_vim))
  call system('git -C ' . shellescape(g:_pm_upd_vim) . ' config user.email "test@test.com"')
  call system('git -C ' . shellescape(g:_pm_upd_vim) . ' config user.name "Test"')
  call writefile(['# vimrc'], g:_pm_upd_vim . '/vimrc')
  call system('git -C ' . shellescape(g:_pm_upd_vim) . ' add .')
  call system('git -C ' . shellescape(g:_pm_upd_vim) . ' commit -m "init vimrc"')

  " 4. Add bare repo as a submodule and initialize it (sets up the remote in
  "    the working-tree clone so fetch/pull have a target to talk to).
  call mkdir(g:_pm_upd_vim . '/pack/plugins/start', 'p')
  call system('git -C ' . shellescape(g:_pm_upd_vim) .
        \ ' -c protocol.file.allow=always submodule add ' . shellescape(g:_pm_upd_bare) .
        \ ' pack/plugins/start/myplugin')
  call system('git -C ' . shellescape(g:_pm_upd_vim) .
        \ ' -c protocol.file.allow=always submodule update --init --recursive')
  call system('git -C ' . shellescape(g:_pm_upd_vim) . ' commit -m "add submodule"')

  " 5. Point plugin manager at the fixture
  let g:plugin_manager_vim_dir     = g:_pm_upd_vim
  let g:plugin_manager_plugins_dir = g:_pm_upd_vim . '/pack/plugins'
  let g:plugin_manager_enable_logging = 0
  " No vimrc declarations in this fixture: point the path at a file that
  " does not exist so the pin parser never reads the developer's real vimrc.
  let g:plugin_manager_vimrc_path = g:_pm_upd_root . '/absent.vimrc'

  " Force the synchronous code path via the test override flag.
  let g:plugin_manager_test_force_sync = 1

  execute 'cd ' . fnameescape(g:_pm_upd_vim)

  let s:_pm_sbuf = bufnr('PluginManager')
  if s:_pm_sbuf != -1
    execute 'bwipeout! ' . s:_pm_sbuf
  endif

  call plugin_manager#git#refresh_modules_cache()

After:
  execute 'cd ' . fnameescape(g:_pm_upd_saved.cwd)
  if isdirectory(g:_pm_upd_root)
    call delete(g:_pm_upd_root, 'rf')
  endif
  let g:plugin_manager_vim_dir        = g:_pm_upd_saved.vim_dir
  let g:plugin_manager_plugins_dir    = g:_pm_upd_saved.plugins_dir
  let g:plugin_manager_vimrc_path     = g:_pm_upd_saved.vimrc
  let g:plugin_manager_enable_logging = g:_pm_upd_saved.logging
  unlet g:plugin_manager_test_force_sync
  unlet g:_pm_upd_saved g:_pm_upd_root g:_pm_upd_bare g:_pm_upd_vim
  unlet g:_pm_upd_plug g:_pm_upd_tmp_src
  let s:_pm_sbuf2 = bufnr('PluginManager')
  if s:_pm_sbuf2 != -1
    execute 'bwipeout! ' . s:_pm_sbuf2
  endif
  call plugin_manager#git#refresh_modules_cache()

Execute (update all - already up-to-date shows Up-to-date):
  " Sync path is forced (g:plugin_manager_test_force_sync). No polling needed.
  call plugin_manager#cmd#update#execute('all')
  let g:_pm_sbuf = bufnr('PluginManager')
  AssertNotEqual -1, g:_pm_sbuf, 'sidebar should open after update'
  let g:_pm_content = join(getbufline(g:_pm_sbuf, 1, '$'), "\n")
  Assert g:_pm_content =~# '\cUp-to-date\|up to date\|Already',
        \ 'expected up-to-date, got: ' . g:_pm_content
  unlet g:_pm_sbuf g:_pm_content

Execute (update specific plugin - already up-to-date):
  call plugin_manager#cmd#update#execute('myplugin')
  let g:_pm_sbuf = bufnr('PluginManager')
  AssertNotEqual -1, g:_pm_sbuf
  let g:_pm_content = join(getbufline(g:_pm_sbuf, 1, '$'), "\n")
  Assert g:_pm_content =~# '\cUp-to-date\|up to date\|Already',
        \ 'expected up-to-date, got: ' . g:_pm_content
  unlet g:_pm_sbuf g:_pm_content

Execute (update all - pulls new commit and submodule HEAD advances):
  " Create v2 commit in the source repo and push to bare
  call writefile(['v2'], g:_pm_upd_tmp_src . '/file.txt')
  call system('git -C ' . shellescape(g:_pm_upd_tmp_src) . ' add .')
  call system('git -C ' . shellescape(g:_pm_upd_tmp_src) . ' commit -m "v2"')
  call system('git -C ' . shellescape(g:_pm_upd_tmp_src) . ' push origin HEAD:main')

  " Ensure the submodule's working-tree remote points to bare (in case the
  " clone was done without --init and the remote was not configured).
  call system('git -C ' . shellescape(g:_pm_upd_plug) .
        \ ' remote set-url origin ' . shellescape(g:_pm_upd_bare))

  " Record expected commit
  let g:_pm_v2_commit = substitute(
        \ system('git -C ' . shellescape(g:_pm_upd_bare) . ' rev-parse main'),
        \ '\n', '', 'g')

  " Manually fetch so the sync update path has the ref available
  call system('git -C ' . shellescape(g:_pm_upd_plug) . ' fetch origin')

  " Verify fetch worked before running the update
  let g:_pm_origin_main = substitute(
        \ system('git -C ' . shellescape(g:_pm_upd_plug) . ' rev-parse origin/main 2>/dev/null'),
        \ '\n', '', 'g')
  if g:_pm_origin_main !=# g:_pm_v2_commit
    " Remote tracking not set up - skip this assertion rather than give a
    " misleading failure (git fixture limitation in headless mode)
    Log 'Skipping: could not configure submodule remote in test fixture'
    unlet g:_pm_v2_commit g:_pm_origin_main
    finish
  endif
  unlet g:_pm_origin_main

  call plugin_manager#cmd#update#execute('all')

  " The submodule HEAD must have advanced to v2
  let g:_pm_plug_head = substitute(
        \ system('git -C ' . shellescape(g:_pm_upd_plug) . ' rev-parse HEAD'),
        \ '\n', '', 'g')
  AssertEqual g:_pm_v2_commit, g:_pm_plug_head,
        \ 'submodule HEAD should be v2 commit after update'

  let g:_pm_sbuf = bufnr('PluginManager')
  AssertNotEqual -1, g:_pm_sbuf
  let g:_pm_content = join(getbufline(g:_pm_sbuf, 1, '$'), "\n")
  Assert g:_pm_content =~# '\cUpdated', 'sidebar should say Updated, got: ' . g:_pm_content
  unlet g:_pm_v2_commit g:_pm_plug_head g:_pm_sbuf g:_pm_content

Execute (local changes survive an up-to-date update - stash pop works):
  " Create a local change in the plugin (not committed)
  call writefile(['local change'], g:_pm_upd_plug . '/local.txt')
  call system('git -C ' . shellescape(g:_pm_upd_plug) . ' add local.txt')

  call plugin_manager#cmd#update#execute('all')

  " The local file must still be present after update (not silently lost)
  Assert filereadable(g:_pm_upd_plug . '/local.txt'),
        \ 'local changes must survive an up-to-date update'

Execute (local changes survive an update that pulls a new commit):
  " Push v2 to bare
  call writefile(['v2'], g:_pm_upd_tmp_src . '/file.txt')
  call system('git -C ' . shellescape(g:_pm_upd_tmp_src) . ' add .')
  call system('git -C ' . shellescape(g:_pm_upd_tmp_src) . ' commit -m "v2"')
  call system('git -C ' . shellescape(g:_pm_upd_tmp_src) . ' push origin HEAD:main')

  " Create a local change in a different file (no conflict with the pull)
  call writefile(['local change'], g:_pm_upd_plug . '/local_no_conflict.txt')
  call system('git -C ' . shellescape(g:_pm_upd_plug) . ' add local_no_conflict.txt')

  call plugin_manager#cmd#update#execute('all')

  " Local file must survive even after a real pull
  Assert filereadable(g:_pm_upd_plug . '/local_no_conflict.txt'),
        \ 'local changes must survive an update that pulls a commit'

Execute (update unknown plugin shows MODULE_NOT_FOUND and handles gracefully):
  call plugin_manager#cmd#update#execute('nonexistentplugin')
  " Error is handled by handle_error; no unhandled exception
  Assert 1

Execute (auto-commit message survives a module name containing shell quotes):
  " Regression: the single-plugin auto-commit interpolated the module name
  " into a double-quoted shell string. A name containing '"' broke the
  " quoting, so the pointer commit silently failed.
  let g:_pm_upd_quoted = g:_pm_upd_vim . '/pack/plugins/start/my"plugin'
  call system('git -C ' . shellescape(g:_pm_upd_vim) .
        \ ' -c protocol.file.allow=always submodule add ' .
        \ shellescape(g:_pm_upd_bare) . ' ''pack/plugins/start/my"plugin''')
  call system('git -C ' . shellescape(g:_pm_upd_vim) . ' commit -m "add quoted submodule"')
  call plugin_manager#git#refresh_modules_cache()

  " Clone is at bare/main; push a new commit and let the update pick it up
  call system('git -C ' . shellescape(g:_pm_upd_tmp_src) . ' commit --allow-empty -m "v3"')
  call system('git -C ' . shellescape(g:_pm_upd_tmp_src) . ' push origin HEAD:main')

  " Fetch so the sync update path sees the new commit behind
  call system('git -C ' . shellescape(g:_pm_upd_quoted) . ' fetch origin')
  let g:_pm_before = substitute(
        \ system('git -C ' . shellescape(g:_pm_upd_quoted) . ' rev-parse HEAD'),
        \ '\n', '', 'g')

  call plugin_manager#cmd#update#execute('my"plugin')

  let g:_pm_after = substitute(
        \ system('git -C ' . shellescape(g:_pm_upd_quoted) . ' rev-parse HEAD'),
        \ '\n', '', 'g')
  Assert g:_pm_before !=# g:_pm_after, 'submodule HEAD should have advanced'

  let g:_pm_msg = system('git -C ' . shellescape(g:_pm_upd_vim) . ' log --format=%s -1')
  Assert g:_pm_msg =~# 'Update Module: my"plugin',
        \ 'pointer commit message must contain the literal name, got: ' . g:_pm_msg
  unlet g:_pm_before g:_pm_after g:_pm_msg g:_pm_upd_quoted

Execute (untracked conflicting files are stashed so the pull succeeds):
  " Upstream adds new.txt while the submodule holds an UNTRACKED new.txt:
  " the stash must include untracked files or the pull fails.
  call writefile(['upstream'], g:_pm_upd_tmp_src . '/new.txt')
  call system('git -C ' . shellescape(g:_pm_upd_tmp_src) . ' add new.txt')
  call system('git -C ' . shellescape(g:_pm_upd_tmp_src) . ' commit -m "add new.txt"')
  call system('git -C ' . shellescape(g:_pm_upd_tmp_src) . ' push -q origin HEAD:main')
  call writefile(['local untracked'], g:_pm_upd_plug . '/new.txt')
  call plugin_manager#cmd#update#execute('all')
  let g:_pm_upd_sb = join(getbufline(bufnr('PluginManager'), 1, '$'), "\n")
  Assert g:_pm_upd_sb =~# '1 of 1 plugins updated',
        \ 'pull must succeed thanks to a untracked-aware stash, got: ' . g:_pm_upd_sb
  let g:_pm_upd_new = join(readfile(g:_pm_upd_plug . '/new.txt'), "\n")
  AssertEqual 'upstream', g:_pm_upd_new, 'the pulled content must win'
  unlet g:_pm_upd_sb g:_pm_upd_new

Execute (auto-commit failures are logged, never silent):
  " A failing pre-commit hook makes the pointer auto-commit fail
  " deterministically; the failure must be visible in the log.
  call writefile(['v2'], g:_pm_upd_tmp_src . '/file.txt')
  call system('git -C ' . shellescape(g:_pm_upd_tmp_src) . ' add file.txt')
  call system('git -C ' . shellescape(g:_pm_upd_tmp_src) . ' commit -m "v2"')
  call system('git -C ' . shellescape(g:_pm_upd_tmp_src) . ' push -q origin HEAD:main')
  call writefile(['#!/bin/sh', 'exit 1'], g:_pm_upd_vim . '/.git/hooks/pre-commit')
  call system('chmod +x ' . shellescape(g:_pm_upd_vim . '/.git/hooks/pre-commit'))
  let g:plugin_manager_enable_logging = 1
  let g:plugin_manager_debug_mode = 1
  call plugin_manager#cmd#update#execute('all')
  let g:_pm_upd_logtext = join(readfile(g:_pm_upd_vim . '/logs/plugin_manager.log'), "\n")
  Assert g:_pm_upd_logtext =~# '\cauto-commit',
        \ 'auto-commit failure must be logged, got: ' . g:_pm_upd_logtext
  unlet g:_pm_upd_logtext g:plugin_manager_debug_mode

Execute (fetch failure is reported and the failed module is excluded):
  " Second module on a healthy remote: it must still update normally
  let g:_pm_upd_plug2 = g:_pm_upd_vim . '/pack/plugins/start/myplugin2'
  call system('git -C ' . shellescape(g:_pm_upd_vim) .
        \ ' -c protocol.file.allow=always submodule add ' .
        \ shellescape(g:_pm_upd_bare) . ' pack/plugins/start/myplugin2')
  call system('git -C ' . shellescape(g:_pm_upd_vim) . ' commit -m "add myplugin2"')
  call plugin_manager#git#refresh_modules_cache()

  " Push v2 AFTER adding the module so both start behind
  call writefile(['v2'], g:_pm_upd_tmp_src . '/file.txt')
  call system('git -C ' . shellescape(g:_pm_upd_tmp_src) . ' add file.txt')
  call system('git -C ' . shellescape(g:_pm_upd_tmp_src) . ' commit -m "v2"')
  call system('git -C ' . shellescape(g:_pm_upd_tmp_src) . ' push -q origin HEAD:main')

  " Break the first module's remote: its fetch must FAIL
  call system('git -C ' . shellescape(g:_pm_upd_plug) .
        \ ' remote set-url origin ' . shellescape(g:_pm_upd_root . '/no-such-bare.git'))
  let g:_pm_upd_head = substitute(
        \ system('git -C ' . shellescape(g:_pm_upd_plug) . ' rev-parse HEAD'),
        \ '\n', '', 'g')
  let g:plugin_manager_enable_logging = 1
  " NOTE: g:plugin_manager_debug_mode is deliberately NOT set (case 9
  " now unlets it): failure details must be logged at warn level,
  " visible in a default setup.

  call plugin_manager#cmd#update#execute('all')

  let g:_pm_upd_sb = join(getbufline(bufnr('PluginManager'), 1, '$'), "\n")
  Assert g:_pm_upd_sb =~# 'Fetch failed',
        \ 'the broken module must show Fetch failed, got: ' . g:_pm_upd_sb
  Assert g:_pm_upd_sb =~# '\cUpdated',
        \ 'the healthy module must still update, got: ' . g:_pm_upd_sb
  let g:_pm_upd_after = substitute(
        \ system('git -C ' . shellescape(g:_pm_upd_plug) . ' rev-parse HEAD'),
        \ '\n', '', 'g')
  AssertEqual g:_pm_upd_head, g:_pm_upd_after,
        \ 'a failed fetch must not touch the module'
  let g:_pm_upd_logtext = join(readfile(g:_pm_upd_vim . '/logs/plugin_manager.log'), "\n")
  Assert g:_pm_upd_logtext =~# 'fetch failed',
        \ 'the fetch failure must be logged, got: ' . g:_pm_upd_logtext
  unlet g:_pm_upd_sb g:_pm_upd_head g:_pm_upd_after g:_pm_upd_logtext
  unlet g:_pm_upd_plug2

Execute (detached HEAD module is skipped with the exact skip message):
  " Characterization: the skip message is shared by both update paths and
  " must stay verbatim (UI copy contract).
  call system('git -C ' . shellescape(g:_pm_upd_plug) . ' checkout -q --detach HEAD')
  call plugin_manager#cmd#dispatch('update', 'myplugin')
  let g:_pm_upd_sb = join(getbufline(bufnr('PluginManager'), 1, '$'), "\n")
  Assert g:_pm_upd_sb =~# 'Detached HEAD: skipped (declare a tag/commit to pin it)',
        \ 'exact detached-HEAD skip message expected, got: ' . g:_pm_upd_sb
  call system('git -C ' . shellescape(g:_pm_upd_plug) . ' checkout -q main')
  unlet g:_pm_upd_sb

Execute (custom-branch module is skipped with the exact skip message):
  call system('git -C ' . shellescape(g:_pm_upd_plug) . ' checkout -qb dev')
  call plugin_manager#cmd#dispatch('update', 'myplugin')
  let g:_pm_upd_sb = join(getbufline(bufnr('PluginManager'), 1, '$'), "\n")
  Assert g:_pm_upd_sb =~# 'On custom branch',
        \ 'custom-branch skip message expected, got: ' . g:_pm_upd_sb
  call system('git -C ' . shellescape(g:_pm_upd_plug) . ' checkout -q main')
  call system('git -C ' . shellescape(g:_pm_upd_plug) . ' branch -D dev')
  unlet g:_pm_upd_sb

Execute (a moved upstream tag does not fail the fetch):
  " Upstream tags can move (re-annotated).  The module's local tag copy is
  " a mirror, never a local creation: git fetch --tags --force must refresh
  " it instead of failing the whole fetch (branch refs update regardless;
  " a plain tag rejection must not mark the module as failed).
  call system('git -C ' . shellescape(g:_pm_upd_tmp_src) . ' tag -a v9.9.9 -m rel')
  call system('git -C ' . shellescape(g:_pm_upd_tmp_src) . ' push -q origin v9.9.9')
  " Local tag with a DIFFERENT tag-object SHA than the remote one.
  call system('git -C ' . shellescape(g:_pm_upd_plug) . ' tag -a v9.9.9 -m local')
  call plugin_manager#cmd#dispatch('update')
  let g:_pm_upd_sb = join(getbufline(bufnr('PluginManager'), 1, '$'), "\n")
  Assert g:_pm_upd_sb !~# 'Fetch failed',
        \ 'a tag clobber rejection must not fail the fetch, got: ' . g:_pm_upd_sb
  " The local tag mirror is refreshed to the remote tag object.
  let g:_pm_upd_local_tag = substitute(
        \ system('git -C ' . shellescape(g:_pm_upd_plug) . ' show-ref --tags v9.9.9'),
        \ '\n', '', 'g')
  let g:_pm_upd_remote_tag = substitute(
        \ system('git -C ' . shellescape(g:_pm_upd_tmp_src) . ' show-ref --tags v9.9.9'),
        \ '\n', '', 'g')
  Assert g:_pm_upd_local_tag ==# g:_pm_upd_remote_tag,
        \ 'tag must be refreshed to the remote object, got: '
        \ . g:_pm_upd_local_tag . ' vs ' . g:_pm_upd_remote_tag
  unlet g:_pm_upd_sb g:_pm_upd_local_tag g:_pm_upd_remote_tag
